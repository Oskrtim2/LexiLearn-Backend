# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lexilearn:lexilearn@localhost:5432/lexilearn?schema=public

# ─── Authentication ─────────────────────────────────────────────────────────
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Startup fails until these values are supplied.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=43200
QR_TOKEN_SECRET=
QR_TOKEN_TTL_SECONDS=31536000
VISUAL_TOKEN_SECRET=
ADMIN_API_KEY=
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ─── TTS signed URLs ────────────────────────────────────────────────────────
TTS_URL_SIGNING_SECRET=
TTS_URL_TTL_SECONDS=3600

# ─── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# ─── OCR provider ───────────────────────────────────────────────────────────
# tesseract (local, no cloud credentials) or textract (AWS)
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng+spa
OCR_TEXT_LOCALE=es
TESSERACT_WORKER_PATH=
TESSERACT_LANG_PATH=
TESSERACT_CACHE_PATH=.tesseract-cache
TEXTRACT_REGION=us-east-1

# ─── TTS provider ───────────────────────────────────────────────────────────
# aws (Amazon Polly) or google (Google Cloud Text-to-Speech)
TTS_PROVIDER=aws
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_POLLY_ENGINE=neural
AWS_POLLY_VOICE_CHILD_FRIENDLY=Joanna
AWS_POLLY_VOICE_CALM_NARRATOR=Danielle
AWS_POLLY_VOICE_NEURAL_FRIENDLY=Matthew

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_CHILD_FRIENDLY=en-US-Neural2-A
GOOGLE_TTS_VOICE_CALM_NARRATOR=en-US-Neural2-C
GOOGLE_TTS_VOICE_NEURAL_FRIENDLY=en-US-Neural2-D
